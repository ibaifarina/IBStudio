# Copy to .env.local and fill in. Set the same variables in your hosting provider for production.

# Resend API key. Leave empty to log leads to the terminal instead of emailing.
RESEND_API_KEY=
# Where contact form leads are sent.
CONTACT_TO_EMAIL=ibaifo8@gmail.com
# Sender. Must use a domain verified in Resend.
CONTACT_FROM_EMAIL="ib.studio <hola@ibstudio.es>"

# Cloudflare Turnstile. Leave both empty to disable the bot check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
